    </div>
    <div>
      <h3><i class="fas fa-brain"></i> AI / ML</h3>
      <p>Hugging Face, CNNs, RAG, Transformers</p>
    </div>
    <div>
      <h3><i class="fas fa-language"></i> Speaking Languages</h3>
      <p>English & Spanish</p>
    </div>
  </div>
</section>



<SectionDivider title="Education" />
<section class="education-section" id="education">
  <h3>Software Engineering.</h3>
  <p>Instituto Tecnologico de Sonora, Graduated 2025</p>
  <p>Relevant Coursework:</p>
  <ul>
    <li>Machine Learning</li>
    <li>Distributed Systems</li>
    <li>Data Structures </li>
    <li>Web Development</li>
  </ul>
</section>

<SectionDivider title="Behind the Scenes 📸" />
<section class="behind-scenes-section" id="behind-the-scenes">
<ProjectCarousel id ="BehindScenes"
  title=""
  images={[
    { src: "/images/BehindScenes/Night.png", caption: "One of many late nights stu-dying 😴" },
    { src: "/images/BehindScenes/3d.png", caption: "First prototype of my 3D engine 🧮" },
    { src: "/images/BehindScenes/mc.png", caption: "Believe it or not, they were working on a final project" },
    { src: "/images/BehindScenes/friends1.jpg", caption: "Taking a break with my friends 😎"},
    { src: "/images/BehindScenes/graph.png", caption: "The result was worth the effort"},
    { src: "/images/BehindScenes/piano.png", caption: "The time I turned my microcontroller into a piano 🎹🎵"},
    { src: "/images/BehindScenes/architecture.png", caption: "Designing my first distributed system 📐 " },
    { src: "/images/BehindScenes/friends2.jpg", caption: "Celebrating the end of the semester! 🎉" }
  ]}
/>
</section>


<SectionDivider title="Contact" />
<section class="contact-section" id="contact">
  <div class="contact-inner">
    <h1>Let’s Connect 🌌</h1>
    <p>Whether it’s about AI, music, software or weird space stuff — feel free to reach out!</p>

    <ul class="contact-list">
      <li>
        <a href="https://www.linkedin.com/in/ericklabrada/" target="_blank" rel="noopener" class="contact-link">
          <img src="/images/linkedin.svg" alt="LinkedIn" />
          LinkedIn
        </a>
      </li>
      <li>
        <a href="https://github.com/ErickLabrada" target="_blank" rel="noopener" class="contact-link">
          <img src="/images/github.svg" alt="GitHub" />
          GitHub
        </a>
      </li>
      <li>
        <a href="mailto:Erick.Labrada233380@gmail.com" class="contact-link">
          <img src="/images/email.svg" alt="Email" />
          Erick.Labrada233380@gmail.com
        </a>
      </li>
    </ul>
  </div>
</section>
</main>

<style>

.skills-section {
  padding: 60px 20px;
  font-family: 'Courier New', Courier, monospace;
  text-align: center;
}

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
  max-width: 1000px;
  margin: 0 auto;
  padding-top: 30px;
}

.skills-grid > div {
  width: 280px;
  background: white;
  padding: 15px 12px;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  border: 1px solid #ccc;
  border-radius: 4px;
  transform: rotate(calc(-2deg + (4 * var(--rotate))));
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: default;
}

.skills-grid > div:hover {
  transform: scale(1.03) rotate(0deg);
  box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
}

.skills-grid h3 {
  font-size: 1rem;
  color: #222;
  margin-bottom: 6px;
  border-bottom: 1px dashed #ccc;
  padding-bottom: 4px;
  display: flex;
  align-items: center;
  justify-content: center; /* Center horizontally */
  gap: 8px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}



.skills-grid h3 i {
  color: #222;
  font-size: 1.1rem;
}

.skills-grid p {
  font-size: 0.85rem;
  color: #333;
  line-height: 1.4;
}
.education-section {
  padding: 20px 15px;
  font-family: 'Courier New', Courier, monospace;
  max-width: 480px;
  margin: 40px auto;
  background: #fff;
  border: 1.5px solid #bbb;
  border-radius: 6px;
  text-align: center;
  color: #444;
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
  transform: rotate(-1deg);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.education-section:hover {
  transform: rotate(0deg) scale(1.04);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
}

.education-section h3 {
  font-size: 1.3rem;
  color: #333;
  margin-bottom: 8px;
  border-bottom: 1.5px dashed #999;
  padding-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.education-section p {
  font-size: 0.95rem;
  color: #666;
  margin: 8px 0 14px;
}

.education-section ul {
  list-style: disc inside;
  max-width: 420px;
  margin: 0 auto;
  padding-left: 0;
  color: #555;
  text-align: left;
}

.education-section li {
  font-size: 0.9rem;
  margin-bottom: 5px;
  line-height: 1.3;
}



 .about {
    padding: 60px 20px 40px;
    margin-top: 30px;
  }

  .about-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 40px;
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: left;
}

.about-photo {
  flex: 1 1 250px;
  display: flex;
  justify-content: center;
}

.about-text {
  flex: 2 1 600px;
  font-family: 'Courier New', Courier, monospace;
  color: #333;
}

.about-text h1 {
  font-size: 2rem;
  margin-bottom: 16px;
}

.about-text p {
  font-size: 1rem;
  line-height: 1.6;
  color: #AAA;
}

.polaroid-gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 40px 20px;
  }

  .download-cv-button {
  display: inline-block;
  margin-top: 1.5rem;
  padding: 0.6rem 1.2rem;
  font-family: 'Courier New', Courier, monospace;
  font-size: 1rem;
  color: #fff;
  background-color: #333;
  border: 2px dashed #aaa;
  text-decoration: none;
  border-radius: 8px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

html {
  scroll-behavior: smooth;
}

.download-cv-button:hover {
  background-color: #555;
  color: #fff;
}

.contact-section {
  padding: 60px 20px 80px;
  text-align: center;
}

.contact-inner {
  max-width: 700px;
  margin: 0 auto;
  font-family: 'Courier New', Courier, monospace;
  color: #333;
}

.contact-inner h1 {
  font-size: 2rem;
  margin-bottom: 10px;
}

.contact-inner p {
  color: #777;
  font-size: 1rem;
  margin-bottom: 30px;
}

.contact-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 15px;
  align-items: center;
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #CCC;
  text-decoration: none;
  border: 2px dashed #aaa;
  padding: 0.6rem 1rem;
  border-radius: 8px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.contact-link:hover {
  background-color: #333;
  color: #fff;
}

.contact-link img {
  width: 24px;
  height: 24px;
}


</style>


  <section aria-label="Utilities">
    <!-- You could also add a theme switch here or anything considered a utility -->
  </section>
</Layout>
