---
import Layout from "@layouts/Layout.astro";
import Polaroid from "@components/Polaroid.astro";
import SectionDivider from "@components/DashedTitle.astro";
import Header from "~/components/Header.astro";
import ProjectCarousel from "@components/ProjectCarousel.astro";
---

<Layout title="Erick's Polaroids ">
  <div class="sr-only" id="start"></div>

<main>
  <Header siteTitle="Erick's Polaroids " />
<section class="about" id="about">
  <div class="about-inner">
    <div class="about-photo">
      <Polaroid
        imageSrc=" images/Platypus.png "
        title="That's me!"
      />
    </div>
    <div class="about-text">
      <h1>Hello World, I'm Erick 👋</h1>
      <p>
        I'm a Software Engineering graduate and aspiring Machine Learning Engineer passionate about building real-world solutions that bridge AI, science, and creativity.
        I enjoy mixing tech with music and science, and exploring the creative boundaries of software development and AI.
        This portfolio is a collection of things I’ve loved creating. <br><br>
        Hope you enjoy flipping through it like old Polaroids. 
      </p>
      <a href="/Resume.pdf" download class="download-cv-button">
  Download CV
</a>

    </div>
  </div>
</section>
<SectionDivider title="Professional Projects" />
<section class="polaroid-gallery" id="projects">

  <Polaroid
    imageSrc="/images/AI_Assistant.jpg"
    title="AI Communication Assistant"
    description="Multi-component AI assistant for real-time business communication, featuring intent detection and a custom RAG pipeline"
    fullDescription="Designed and implemented an AI-powered communication assistant for dynamic user interaction. Built the system architecture and core backend using Python and MongoDB. Integrated custom intent detection with a Retrieval-Augmented Generation (RAG) pipeline leveraging Hugging Face models to interpret queries and retrieve relevant business data. Due to NDA restrictions, source code and UI are not publicly available."
    technologies={["Python", "MongoDB", "Hugging Face"]}
  />

  <Polaroid
    imageSrc="/images/sully.png"
    title="Distributed Ticket Receiver"
    description="Task management app for handling distributed, ticket-based workflows"
    fullDescription="Real-time dashboard with automated task processing, report generation, and synchronized status updates across distributed systems"
    technologies={["Django", "JavaScript", "PostgreSQL", "Redis"]}
  />

  <Polaroid
    imageSrc="/images/anam.png"
    title="Distributed Ticket Source Service"
    description="Migrated a legacy distributed task management system to a scalable NestJS-based architecture"
    fullDescription="Refactored a legacy JavaScript system into a structured NestJS backend, improving maintainability and scalability. Supports report generation and synchronized status updates across distributed services."
    technologies={["NestJS", "PostgreSQL"]}
  />

</section>
<SectionDivider title="Personal Projects" />
<section class="polaroid-gallery" id="projects">

  <Polaroid
    imageSrc="/images/DailyAI.png"
    title="DailyAI"
    description="Automated standup reporting tool that generates and delivers daily updates using LLMs and text-to-speech"
    fullDescription="Built an automation pipeline to generate daily standup reports by scraping activity data from a kanban board using Playwright and retrieving additional context via the GitLab API. The data is processed through an LLM to generate a structured report, which is then converted to speech and played during meetings via a virtual microphone. A playful project that combines automation, scraping, and AI-driven summarization."
    technologies={["Python", "Playwright", "GitLab API", "OpenAI API"]}
  />

  <Polaroid
    imageSrc="/images/GreenHouse.png"
    title="Distributed Greenhouse Monitoring System"
    description="Scalable multi-sensor platform with real-time alerts and microservices architecture"
    fullDescription="Designed a distributed backend system to aggregate and process sensor data from multiple greenhouses. Built a middleware service to authenticate devices, normalize heterogeneous data formats, detect threshold violations, and trigger SMS alerts via Twilio. The system uses RabbitMQ for asynchronous communication between microservices and provides a REST API for external analytics. Data is stored in MongoDB, with MySQL used for configuration management. Also developed an ESP32-based simulator to emulate real sensor input via WebSockets."
    githubUrl="https://github.com/ErickLabrada/Sistema-de-sensores-para-invernadero"
    technologies={["Nest.js", "TypeScript", "Python", "Flask", "RabbitMQ", "MongoDB", "MySQL", "ESP32 & C++", "Twilio API", "WebSockets"]}
  />

  <Polaroid
    imageSrc="/images/CIA.png"
    title="Academic Information System (CIA)"
    description="University enrollment system with curriculum validation and schedule conflict detection"
    fullDescription="Developed a modernized enrollment system with separate admin and student interfaces. Administrators can configure courses and curricula, while students can enroll with enforced prerequisite validation and schedule conflict detection. Built using microfrontend architecture and JWT-based authentication. Focused on usability while handling complex academic rules."
    githubUrl="https://github.com/DanielPenaGarcia/academic-information-center"
    technologies={["JavaScript", "HTML", "CSS", "JWT", "Microfrontends"]}
  />

  <Polaroid
    imageSrc="/images/3D_Engine.gif"
    title="3D Engine"
    description="Custom 3D rendering engine built from scratch using Java and linear algebra"
    fullDescription="Developed a basic 3D engine implementing core graphics concepts such as perspective projection, rotation matrices, and real-time rendering. Supports hardcoded models with transformations and coloring. Built as a hands-on exploration of linear algebra and low-level graphics programming."
    githubUrl="https://github.com/ErickLabrada/3D_Engine"
    technologies={["Java", "Linear Algebra"]}
  />

  <Polaroid
    imageSrc="/images/wbot.png"
    title="Photography Studio Management System"
    description="Backend system for managing studio operations with WhatsApp-based customer interaction"
    fullDescription="Built the backend for a photography studio management platform, handling business data and appointment scheduling. Integrated a WhatsApp chatbot to allow customers to inquire about services and book appointments through conversational messaging. Developed with Nest.js, TypeScript, and MySQL, focusing on reliability and API integration."
    githubUrl="https://github.com/ErickLabrada/Eilyn-Garcia-Fotografia-Sistema-Gestion/tree/Development"
    technologies={["Nest.js", "TypeScript", "MySQL", "BuilderBot"]}
  />

</section>

<SectionDivider title="Skills" />
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
/>

<section class="skills-section" id="skills">
  <div class="skills-grid">
    
    <div>
      <h3><i class="fas fa-code"></i> Programming Languages</h3>
      <p>Python, TypeScript, JavaScript, Java, Go</p>
    </div>

    <div>
      <h3><i class="fas fa-layer-group"></i> Frameworks & Libraries</h3>
      <p>NestJS, Flask, Express, Chi, LangChain, LangGraph</p>
    </div>

    <div>
      <h3><i class="fas fa-toolbox"></i> Tools & Infrastructure</h3>
      <p>Git, Docker, RabbitMQ, Redis, PostgreSQL, MySQL, MongoDB</p>
    </div>

    <div>
      <h3><i class="fas fa-brain"></i> AI / Machine Learning</h3>
      <p>Hugging Face, Transformers, Retrieval-Augmented Generation (RAG), CNNs</p>
    </div>

    <div>
      <h3><i class="fas fa-language"></i> Languages</h3>
      <p>Spanish (Native), English (Fluent)</p>
    </div>

  </div>
</section>


<SectionDivider title="Education" />

<section class="education-section" id="education">
  <h3>B.S. in Software Engineering</h3>
  <p>Instituto Tecnológico de Sonora — Graduated 2025</p>

  <p><strong>Relevant Coursework:</strong></p>
  <ul>
    <li>Machine Learning Fundamentals</li>
    <li>Software Architecture & Design</li>
    <li>Distributed Systems</li>
    <li>Data Structures</li>
    <li>Web Development</li>
  </ul>
</section>

<SectionDivider title="Contact" />
<section class="contact-section" id="contact">
  <div class="contact-inner">
    <h1>Let’s Connect 🌌</h1>
    <p>Whether it’s about AI, music, software or weird space stuff — feel free to reach out!</p>

    <ul class="contact-list">
      <li>
        <a href="https://www.linkedin.com/in/ericklabrada/" target="_blank" rel="noopener" class="contact-link">
          <img src="/images/linkedin.svg" alt="LinkedIn" />
          LinkedIn
        </a>
      </li>
      <li>
        <a href="https://github.com/ErickLabrada" target="_blank" rel="noopener" class="contact-link">
          <img src="/images/github.svg" alt="GitHub" />
          GitHub
        </a>
      </li>
      <li>
        <a href="mailto:Erick.Labrada233380@gmail.com" class="contact-link">
          <img src="/images/email.svg" alt="Email" />
          Erick.Labrada233380@gmail.com
        </a>
      </li>
    </ul>
  </div>
</section>
</main>

<style>

.skills-section {
  padding: 60px 20px;
  font-family: 'Courier New', Courier, monospace;
  text-align: center;
}

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
  max-width: 1000px;
  margin: 0 auto;
  padding-top: 30px;
}

.skills-grid > div {
  width: 280px;
  background: white;
  padding: 15px 12px;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  border: 1px solid #ccc;
  border-radius: 4px;
  transform: rotate(calc(-2deg + (4 * var(--rotate))));
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: default;
}

.skills-grid > div:hover {
  transform: scale(1.03) rotate(0deg);
  box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
}

.skills-grid h3 {
  font-size: 1rem;
  color: #222;
  margin-bottom: 6px;
  border-bottom: 1px dashed #ccc;
  padding-bottom: 4px;
  display: flex;
  align-items: center;
  justify-content: center; /* Center horizontally */
  gap: 8px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}



.skills-grid h3 i {
  color: #222;
  font-size: 1.1rem;
}

.skills-grid p {
  font-size: 0.85rem;
  color: #333;
  line-height: 1.4;
}
.education-section {
  padding: 20px 15px;
  font-family: 'Courier New', Courier, monospace;
  max-width: 480px;
  margin: 40px auto;
  background: #fff;
  border: 1.5px solid #bbb;
  border-radius: 6px;
  text-align: center;
  color: #444;
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
  transform: rotate(-1deg);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.education-section:hover {
  transform: rotate(0deg) scale(1.04);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
}

.education-section h3 {
  font-size: 1.3rem;
  color: #333;
  margin-bottom: 8px;
  border-bottom: 1.5px dashed #999;
  padding-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.education-section p {
  font-size: 0.95rem;
  color: #666;
  margin: 8px 0 14px;
}

.education-section ul {
  list-style: disc inside;
  max-width: 420px;
  margin: 0 auto;
  padding-left: 0;
  color: #555;
  text-align: left;
}

.education-section li {
  font-size: 0.9rem;
  margin-bottom: 5px;
  line-height: 1.3;
}



 .about {
    padding: 60px 20px 40px;
    margin-top: 30px;
  }

  .about-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 40px;
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: left;
}

.about-photo {
  flex: 1 1 250px;
  display: flex;
  justify-content: center;
}

.about-text {
  flex: 2 1 600px;
  font-family: 'Courier New', Courier, monospace;
  color: #333;
}

.about-text h1 {
  font-size: 2rem;
  margin-bottom: 16px;
}

.about-text p {
  font-size: 1rem;
  line-height: 1.6;
  color: #AAA;
}

.polaroid-gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 40px 20px;
  }

  .download-cv-button {
  display: inline-block;
  margin-top: 1.5rem;
  padding: 0.6rem 1.2rem;
  font-family: 'Courier New', Courier, monospace;
  font-size: 1rem;
  color: #fff;
  background-color: #333;
  border: 2px dashed #aaa;
  text-decoration: none;
  border-radius: 8px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

html {
  scroll-behavior: smooth;
}

.download-cv-button:hover {
  background-color: #555;
  color: #fff;
}

.contact-section {
  padding: 60px 20px 80px;
  text-align: center;
}

.contact-inner {
  max-width: 700px;
  margin: 0 auto;
  font-family: 'Courier New', Courier, monospace;
  color: #333;
}

.contact-inner h1 {
  font-size: 2rem;
  margin-bottom: 10px;
}

.contact-inner p {
  color: #777;
  font-size: 1rem;
  margin-bottom: 30px;
}

.contact-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 15px;
  align-items: center;
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #CCC;
  text-decoration: none;
  border: 2px dashed #aaa;
  padding: 0.6rem 1rem;
  border-radius: 8px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.contact-link:hover {
  background-color: #333;
  color: #fff;
}

.contact-link img {
  width: 24px;
  height: 24px;
}


</style>


  <section aria-label="Utilities">
    <!-- You could also add a theme switch here or anything considered a utility -->
  </section>
</Layout>
