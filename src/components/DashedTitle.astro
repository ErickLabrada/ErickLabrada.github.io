---
// Props: title (string)
const { title } = Astro.props;
---

<div class="dashed-title">
  <h2>{title}</h2>
</div>

<style>
  .dashed-title {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 40px 0 30px;
        content: "";
    flex-grow: 1;
    height: 1px;
    border-bottom: 2px dashed #ccc;
    margin: 0 0px;
    margin-left: 60px;
    margin-right: 60px;
    margin-bottom: 15px;
    margin-top: 15px;

  }

  .dashed-title h2 {
    position: relative;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1.75rem;
    color: #444;
    padding: 0 1rem;
    background: #fff;
    z-index: 1;
  }

  .dashed-title::before,
  .dashed-title::after {

  }
</style>
