---
const { imageSrc, title, description, alt, fullDescription, githubUrl, technologies = [] } = Astro.props;
const modalId = title.toLowerCase().replace(/\s+/g, '-');
const rotation = (Math.random() * 6) - 3; 
---

<div class="polaroid" style={`transform: rotate(${rotation}deg);`}onclick={`showModal('${modalId}')`}>
  <div class="image-wrapper">
    <img src={imageSrc} alt={alt || title} />
  </div>
  <div class="title">{title}</div>
  <div class="description">{description}</div>
</div>

<!-- Modal -->
<div id={modalId} class="modal">
  <div class="modal-content">
    <span class="close" onclick={`closeModal('${modalId}')`}>&times;</span>
    <div class="modal-header">
      <h2>{title}</h2>
    </div>
    <img src={imageSrc} alt={alt || title} class="modal-image" />
    <p class="modal-description">{fullDescription || description}</p>
    {technologies.length > 0 && (
      <div class="tech-stack">
        <h4>Technologies Used</h4>
        <ul>
          {technologies.map((tech: string) => <li>{tech}</li>)}
        </ul>
      </div>
    )}
{githubUrl && (
  <div class="github-button-container">
    <a href={githubUrl} class="github-button" target="_blank" rel="noopener noreferrer">
      View on GitHub
    </a>
  </div>
)}


  </div>
</div>

<style>
  .polaroid {
    width: 240px;
    background: white;
    padding: 10px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    text-align: center;
    font-family: 'Courier New', Courier, monospace;
    margin: 20px;
    transition: transform 0.3s ease;
    border: 1px solid #ccc;
    cursor: pointer;
  }

  .polaroid:hover {
    transform: scale(1.03) rotateZ(0deg);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
  }

  .image-wrapper {
    width: 100%;
    height: 200px;
    overflow: hidden;
    border: 1px solid #ddd;
    background-color: #f9f9f9;
  }

  .polaroid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;

  }

  .title {
    font-size: 0.9rem;
    font-weight: bold;
    color: #333;
    margin-top: 10px;
  }



  .description {
    font-size: 0.75rem;
    color: #111;
    margin-top: 4px;
  }

  /* Modal styles */
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.6);
  }

  .modal-content {
    background-color: white;
    margin: 5% auto;
    padding: 30px;
    border-radius: 8px;
    max-width: 700px;
    width: 90%;
    position: relative;
    font-family: 'Arial', sans-serif;
    box-shadow: 0 5px 25px rgba(0,0,0,0.4);
  }


  
  .close {
    color: #888;
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
  }

  .close:hover {
    color: black;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }


  .modal-header h2 {
    margin: 0;
    font-size: 1.5rem;
    color: #24292e;
  }

.github-button {
  background-color: #24292e;
  color: white;
  padding: 8px 14px;
  border-radius: 5px;
  text-decoration: none;
  font-size: 0.9rem;
}

.github-button-container {
  display: flex;
  justify-content: flex-end;
  margin-top: 20px;
}


  .github-button:hover {
    background-color: #444c56;
  }

  .modal-image {
    width: 100%;
    max-height: 300px;
    object-fit: cover;
    margin: 20px 0;
    border-radius: 4px;
  }

  .modal-description {
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
  }

  .tech-stack {
    margin-top: 20px;
  }

  .tech-stack h4 {
    margin-bottom: 10px;
    font-size: 1.1rem;
    color: #444c56;
  }

  .tech-stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  .tech-stack li {
    background-color: #333;
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
  }
</style>

<script is:inline>
  function showModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.style.display = 'block';
  }

  function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.style.display = 'none';
  }

  window.addEventListener('click', function(event) {
    const modals = document.querySelectorAll('.modal');
    modals.forEach(modal => {
      if (event.target === modal) {
        modal.style.display = 'none';
      }
    });
  });
</script>
