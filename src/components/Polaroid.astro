---
const { imageSrc, title, description, alt } = Astro.props;
---

<div class="polaroid" style={`transform: rotate(${Math.random() * 6 - 3}deg)`}>
  <div class="image-wrapper">
    <img src={imageSrc} alt={alt || title} />
  </div>
  <div class="title">{title}</div>
  <div class="description">{description}</div>

</div>

<style>
  .polaroid {
    width: 240px;
    background: white;
    padding: 10px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
    text-align: center;
    font-family: 'Courier New', Courier, monospace;
    margin: 20px;
    transition: transform 0.3s ease;
    border: 1px solid #ccc;
  }

  .polaroid:hover {
    transform: scale(1.03) rotateZ(0deg);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.4);
  }

  .image-wrapper {
    width: 100%;
    height: 200px;
    overflow: hidden;
    border: 1px solid #ddd;
    box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.1);
    background-color: #f9f9f9;
  }

  .polaroid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .title {
    font-size: 0.9rem;
    font-weight: bold;
    color: #333;
    margin-top: 10px;
  }

  .description {
    font-size: 0.75rem;
    color: #555;
    margin-top: 4px;
  }

  </style>
